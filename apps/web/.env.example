# Copy to .env.local for local development. Never commit .env files.

# Where the Express API runs. The /api/* rewrite in next.config.ts forwards requests here.
# Production: https://<your-api>.onrender.com
API_ORIGIN=http://localhost:4000

# Origin of the S3 bucket. The Content-Security-Policy allows uploads to it and image previews from it.
# Production: https://<bucket>.s3.<region>.amazonaws.com
STORAGE_ORIGIN=http://localhost:9000
