# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000
TZ=UTC
LOG_LEVEL=debug

# Local Docker Postgres (docker compose up -d). In production, use Render's *internal* URL.
DATABASE_URL=postgresql://evidencechase:evidencechase@localhost:5432/evidencechase
# Used only by the integration tests. They wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgresql://evidencechase:evidencechase@localhost:5432/evidencechase_test

# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Origin of the web app. State-changing requests from any other origin are refused.
WEB_ORIGIN=http://localhost:3000

# Number of proxies between the browser and this server, so req.ip and secure cookies work.
# Local: 1 (the Next.js dev proxy). Production: Vercel → Render, so start at 2 and confirm in logs.
TRUST_PROXY=1

# ---- Object storage ----
# Local: the RustFS container from docker compose (create the bucket with: pnpm storage:setup).
# Production: AWS S3, with the least-privilege IAM user from infra/aws/api-policy.json, and no S3_ENDPOINT.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=evidencechase
AWS_SECRET_ACCESS_KEY=evidencechase-secret
S3_BUCKET=evidencechase-dev
S3_ENDPOINT=http://localhost:9000
# Wait for GuardDuty's malware scan before promoting files. There's no GuardDuty locally, so off.
MALWARE_SCAN_ENABLED=false
OBJECT_LOCK_RETENTION_DAYS=90

# ---- Evidence export ----
# Public URL of this API: export downloads go straight here (not through the web app's proxy).
# Production: https://<your-api>.onrender.com
API_PUBLIC_URL=http://localhost:4000
# Signs the 60-second export links. Generate with: openssl rand -base64 32
EXPORT_SIGNING_SECRET=change-me-local-export-signing-secret-0123456789

# ---- Scheduled jobs ----
# Bearer secret cron-job.org sends to /internal/cron/*. Generate with: openssl rand -base64 32
# Without it, the scan-check job is switched off (submits still promote files directly).
# CRON_SECRET=

# ---- Email ----
# Without a Resend key, emails (including owners' magic links) are written to the API log.
# RESEND_API_KEY=
# EMAIL_FROM=EvidenceChase <evidence@yourdomain.com>
